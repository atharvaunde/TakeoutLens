# Copy to .env.local (native runs) or .env (docker compose) and adjust.

# Extracted Takeout folder. Read-only: the app never writes here.
# Either the folder holding Mail/, Drive/, ... or its parent holding Takeout/.
TAKEOUT_DIR=/path/to/extracted/takeout

# Writable folder for the index, thumbnails, auth.json and sessions (native runs only;
# Docker uses the viewer-data volume mounted at /data).
DATA_DIR=./.data

# Extra hostnames accepted in the Host header, comma-separated (e.g. behind a reverse proxy).
# localhost, 127.0.0.1 and [::1] are always allowed.
# ALLOWED_HOSTS=takeout.lan
